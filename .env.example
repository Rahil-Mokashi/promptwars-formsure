# Firebase web config (Project settings > General > Your apps). These are public identifiers, not secrets,
# but keep your real values in .env, which is git-ignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Gemini model used through Firebase AI Logic
VITE_GEMINI_MODEL=gemini-3.8-flash
