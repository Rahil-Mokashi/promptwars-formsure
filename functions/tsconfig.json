{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts"]
}
